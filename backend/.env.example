REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_MAX_CANDIDATES=200
OLLAMA_MODEL=llama3:8b
# User-facing replies for the local routing tier. The Decision Agent does not use this.
LOCAL_RESPONSE_MODEL=openai/gpt-oss-20b
OLLAMA_API_BASE=http://localhost:11434
# Hosted Ollama credential for cloud decision models on Vercel.
# Leave unset to classify through the local Ollama daemon.
# OLLAMA_API_KEY=
# Decision Agent only. Local answer generation keeps OLLAMA_MODEL.
DECISION_OLLAMA_MODEL=gemma4:31b-cloud
DECISION_TIMEOUT_SECONDS=180
CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# Maximum time in seconds for each model provider request (primary and fallback).
PROVIDER_TIMEOUT_SECONDS=8
# Maximum time in seconds for each local Ollama generation request.
OLLAMA_TIMEOUT_SECONDS=30
# Embeddings for context ranking and the semantic cache.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-PNuiLeNXfyGeK9MKkyIbns4SXrhQNI-DwG5YRBqQNwP
VOYAGE_API_BASE=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
# Optional local embeddings: EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest

# Maximum time in seconds for each quality evaluation request.
QUALITY_TIMEOUT_SECONDS=20

# Leave unset for local SQLite. Set the Neon pooled URL in Vercel production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Chat history is stored in MongoDB Atlas. Do not commit the real connection string.
MONGODB_URI=mongodb+srv://sujitgunjal91:sujitgunjal91@cluster0.a5m9guh.mongodb.net/
MONGODB_DB_NAME=switchboard
