REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_MAX_CANDIDATES=200
OLLAMA_MODEL=llama3:8b
OLLAMA_API_BASE=http://localhost:11434
CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# Maximum time in seconds for each model provider request (primary and fallback).
PROVIDER_TIMEOUT_SECONDS=8
# Maximum time in seconds for each local Ollama generation request.
OLLAMA_TIMEOUT_SECONDS=30
# Maximum time in seconds for each quality evaluation request.
QUALITY_TIMEOUT_SECONDS=20
